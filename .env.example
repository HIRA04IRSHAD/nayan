# Get a key from https://aistudio.google.com/apikey and copy this file to .env.local
GEMINI_API_KEY=
# Optional: override the vision model and the fallback chain (used when Google is overloaded)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.8-flash
# Optional, family confirmation links: the public origin used in the caregiver link (set it behind a proxy),
# and where caregiver cases are stored (default data/cases/; needs a persistent disk, see README).
# NAYAN_PUBLIC_URL=https://nayan.example.org
# NAYAN_CASES_DIR=/var/lib/nayan/cases
